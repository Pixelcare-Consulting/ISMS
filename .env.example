# Copy to .env.local and fill in values. Never commit real secrets.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/isms
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/isms

# Auth
AUTH_SECRET=replace-me
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Optional: public self-serve register
ALLOW_PUBLIC_REGISTER=false

# ISMS Assist (OpenAI) — unchanged; separate from Pixelcare AI
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Pixelcare AI (/internal/ai) — off by default (kill switch)
PIXELCARE_AI_ENABLED=false
# Optional lockdown: leave empty for all signed-in users when enabled.
# Non-empty = only these user ids and/or emails (case-insensitive).
PIXELCARE_AI_USER_IDS=
PIXELCARE_AI_SAMPLE_MODE=false

# Qwen / Alibaba Cloud Model Studio (OpenAI-compatible)
# Example base URL shape:
# https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus

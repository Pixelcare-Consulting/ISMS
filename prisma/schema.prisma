// --- BRS organization ---

model Dealer {
  id              String       @id @default(cuid())
  tenantId        String       @map("tenant_id")
  name            String
  sapCode         String?      @map("sap_code")
  status          BranchStatus @default(active)
  areaId          String?      @map("area_id")
  dealerTypeId    String?      @map("dealer_type_id")
  dealerAreaId    String?      @map("dealer_area_id")
  modeOfPaymentId String?      @map("mode_of_payment_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area          Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  dealerType    DealerType?    @relation(fields: [dealerTypeId], references: [id], onDelete: SetNull)
  dealerArea    DealerArea?    @relation(fields: [dealerAreaId], references: [id], onDelete: SetNull)
  modeOfPayment ModeOfPayment? @relation(fields: [modeOfPaymentId], references: [id], onDelete: SetNull)
  branches      Branch[]
  aors          Aor[]
  salesReplacements SalesReplacement[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("dealers")
}

model ServiceCenter {
  id              String       @id @default(cuid())
  tenantId        String       @map("tenant_id")
  sapCode         String       @map("sap_code")
  name            String
  status          BranchStatus @default(active)
  areaId          String?      @map("area_id")
  dealerTypeId    String?      @map("dealer_type_id")
  dealerAreaId    String?      @map("dealer_area_id")
  modeOfPaymentId String?      @map("mode_of_payment_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area          Area?                   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  dealerType    DealerType?             @relation(fields: [dealerTypeId], references: [id], onDelete: SetNull)
  dealerArea    DealerArea?             @relation(fields: [dealerAreaId], references: [id], onDelete: SetNull)
  modeOfPayment ModeOfPayment?          @relation(fields: [modeOfPaymentId], references: [id], onDelete: SetNull)
  locations     ServiceCenterLocation[]
  aors          Aor[]
  inventories   ServiceCenterInventory[]
  orders        ServiceCenterOrder[]
  deliveries    ServiceCenterDelivery[]
  backloads     ServiceBackload[]
  sales         ServiceCenterSalesTransaction[]
  pullouts      ServiceCenterPullout[]

  @@unique([tenantId, sapCode])
  @@index([tenantId])
  @@map("service_centers")
}

model ServiceCenterLocation {
  id              String   @id @default(cuid())
  serviceCenterId String   @map("service_center_id")
  code            String
  name            String
  areaId          String?  @map("area_id")
  dealerAreaId    String?  @map("dealer_area_id")
  regionId        String?  @map("region_id")
  provinceId      String?  @map("province_id")
  branchAreaId    String?  @map("branch_area_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  serviceCenter ServiceCenter @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  area          Area?         @relation(fields: [areaId], references: [id], onDelete: SetNull)
  dealerArea    DealerArea?   @relation(fields: [dealerAreaId], references: [id], onDelete: SetNull)
  region        Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  province      Province?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  branchArea    BranchArea?   @relation(fields: [branchAreaId], references: [id], onDelete: SetNull)
  aors          Aor[]
  inventories   ServiceCenterInventory[]
  orders        ServiceCenterOrder[]
  deliveries    ServiceCenterDelivery[]
  backloads     ServiceBackload[]
  sales         ServiceCenterSalesTransaction[]
  pullouts      ServiceCenterPullout[]
  branchReturnRequests BranchReturnRequest[]

  @@unique([serviceCenterId, code])
  @@map("service_center_locations")
}

model PriceList {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  modelId       String   @map("model_id")
  amount        Decimal  @db.Decimal(12, 2)
  periodStart   DateTime @map("period_start")
  periodEnd     DateTime @map("period_end")
  packageTypeId String?  @map("package_type_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model       ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  packageType PackageType? @relation(fields: [packageTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId, modelId])
  @@index([tenantId, periodStart, periodEnd])
  @@map("price_lists")
}

model Branch {
  id                 String       @id @default(cuid())
  tenantId           String       @map("tenant_id")
  sapCode            String       @map("sap_code")
  name               String
  /// Legacy geography FK (was incorrectly named branch_area_id → Area).
  areaId             String?      @map("area_id")
  branchAreaId       String?      @map("branch_area_id")
  dealerId           String?      @map("dealer_id")
  primaryWarehouseId String?      @map("primary_warehouse_id")
  regionId           String?      @map("region_id")
  provinceId         String?      @map("province_id")
  branchStatusTypeId String?      @map("branch_status_type_id")
  deliverySchedule   Json?        @map("delivery_schedule")
  status             BranchStatus @default(active)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  area                  Area?                  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  branchArea            BranchArea?            @relation(fields: [branchAreaId], references: [id], onDelete: SetNull)
  dealer                Dealer?                @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  primaryWarehouse      Warehouse?             @relation("BranchPrimaryWarehouse", fields: [primaryWarehouseId], references: [id], onDelete: SetNull)
  region                Region?                @relation(fields: [regionId], references: [id], onDelete: SetNull)
  province              Province?              @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  branchStatusType      BranchStatusType?      @relation(fields: [branchStatusTypeId], references: [id], onDelete: SetNull)
  alternateWarehouses   AlternateWarehouse[]
  aors                  Aor[]
  branchInventories     BranchInventory[]
  branchPlanograms      BranchPlanogram[]
  branchMilSettings     BranchMilSetting[]
  branchOrders          BranchOrder[]
  branchDeliveries      BranchDelivery[]
  transfersFrom         BranchTransfer[]       @relation("TransferFromBranch")
  transfersTo           BranchTransfer[]       @relation("TransferToBranch")
  branchPullouts        BranchPullout[]
  branchSales           BranchSalesTransaction[]
  branchForecastTargets BranchForecastTarget[]
  branchAllocations     BranchAllocation[]
  stockCountSessions    StockCountSession[]
  branchBackloads       BranchBackload[]
  branchQuotas          BranchQuota[]
  salesReplacements     SalesReplacement[]
  competitorObservations CompetitorObservation[]

  @@unique([tenantId, sapCode])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  code            String
  name            String
  isMain          Boolean  @default(false) @map("is_main")
  modeOfPaymentId String?  @map("mode_of_payment_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modeOfPayment       ModeOfPayment?       @relation(fields: [modeOfPaymentId], references: [id], onDelete: SetNull)
  locations           WarehouseLocation[]
  alternateWarehouses AlternateWarehouse[]
  primaryBranches     Branch[]             @relation("BranchPrimaryWarehouse")
  aors                Aor[]
  pulloutsDestination BranchPullout[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(cuid())
  warehouseId String   @map("warehouse_id")
  code        String
  name        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse            Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inventories          WarehouseInventory[]
  aors                 Aor[]
  branchPullouts       BranchPullout[]
  deliveryLinesFrom    BranchDeliveryLine[] @relation("DeliveryLineWarehouseFrom")

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model AlternateWarehouse {
  id          String   @id @default(cuid())
  branchId    String   @map("branch_id")
  warehouseId String   @map("warehouse_id")
  createdAt   DateTime @default(now()) @map("created_at")

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([branchId, warehouseId])
  @@map("alternate_warehouses")
}

model Aor {
  id                      String              @id @default(cuid())
  tenantId                String              @map("tenant_id")
  userId                  String              @map("user_id")
  name                    String?
  branchId                String?             @map("branch_id")
  warehouseId             String?             @map("warehouse_id")
  warehouseLocationId     String?             @map("warehouse_location_id")
  dealerId                String?             @map("dealer_id")
  serviceCenterId         String?             @map("service_center_id")
  serviceCenterLocationId String?             @map("service_center_location_id")
  status                  LookupRecordStatus  @default(active)
  createdById             String?             @map("created_by_id")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy             User?                  @relation("AorCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseLocation     WarehouseLocation?     @relation(fields: [warehouseLocationId], references: [id], onDelete: SetNull)
  dealer                Dealer?                @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  serviceCenter         ServiceCenter?         @relation(fields: [serviceCenterId], references: [id], onDelete: SetNull)
  serviceCenterLocation ServiceCenterLocation? @relation(fields: [serviceCenterLocationId], references: [id], onDelete: SetNull)

  @@index([tenantId, userId])
  @@index([createdById])
  @@map("aors")
}

// --- BRS reference: Reason/Status (ISMS-v2 schema) ---

model ReasonStatus {
  id           String               @id @default(cuid())
  tenantId     String               @map("tenant_id")
  category     ReasonStatusCategory
  name         String
  code         String
  recordStatus LookupRecordStatus   @default(active) @map("record_status")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codes               ReasonStatusCode[]
  pulloutsAsReason    BranchPullout[]      @relation("PulloutReasonStatus")
  scPulloutsAsReason  ServiceCenterPullout[] @relation("ScPulloutReasonStatus")

  @@unique([tenantId, category, code])
  @@index([tenantId, category])
  @@map("reason_statuses")
}

model ReasonStatusCode {
  id             String             @id @default(cuid())
  tenantId       String             @map("tenant_id")
  reasonStatusId String             @map("reason_status_id")
  name           String
  code           String
  sortOrder      Int                @default(0) @map("sort_order")
  isSystem       Boolean            @default(false) @map("is_system")
  recordStatus   LookupRecordStatus @default(active) @map("record_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  tenant                    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reasonStatus              ReasonStatus      @relation(fields: [reasonStatusId], references: [id], onDelete: Cascade)
  branchInventories         BranchInventory[]
  branchDeliveries          BranchDelivery[]
  branchTransfers           BranchTransfer[]
  branchPulloutsWorkflow    BranchPullout[]   @relation("PulloutWorkflowStatus")
  branchPulloutsReasonCode  BranchPullout[]   @relation("PulloutReasonCode")
  serviceCenterInventories  ServiceCenterInventory[]
  serviceCenterDeliveries   ServiceCenterDelivery[]
  scPulloutsWorkflow        ServiceCenterPullout[] @relation("ScPulloutWorkflowStatus")
  scPulloutsReasonCode      ServiceCenterPullout[] @relation("ScPulloutReasonCode")

  @@unique([tenantId, reasonStatusId, code])
  @@index([tenantId])
  @@map("reason_status_codes")
}

// --- BRS inventory ---

model SerialNumber {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  serialNo     String             @map("serial_no")
  modelId      String             @map("model_id")
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model             ProductModel              @relation(fields: [modelId], references: [id], onDelete: Cascade)
  branchInventories BranchInventory[]
  branchSales       BranchSalesTransaction[]
  transferLines     BranchTransferLine[]
  pulloutLines      BranchPulloutLine[]
  stockCountLines   StockCountLine[]
  salesDetails      BranchSalesTransactionDetail[]
  salesReplacementsOriginal SalesReplacement[] @relation("SalesReplacementOriginalSn")
  salesReplacementsReplacement SalesReplacement[] @relation("SalesReplacementReplacementSn")
  branchBackloads   BranchBackload[]
  warehouseInventories WarehouseInventory[]
  deliveryLines     BranchDeliveryLine[]
  history           SerialNumberHistory[]
  serviceCenterInventories ServiceCenterInventory[]
  serviceCenterSales ServiceCenterSalesTransaction[]
  serviceCenterPulloutDetails ServiceCenterPulloutDetail[]
  serviceBackloads  ServiceBackload[]

  @@unique([tenantId, serialNo])
  @@index([tenantId])
  @@index([modelId])
  @@map("serial_numbers")
}

model BranchInventory {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  serialNumberId String   @map("serial_number_id")
  statusCodeId   String   @map("status_code_id")
  updatedById    String?  @map("updated_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serialNumber SerialNumber     @relation(fields: [serialNumberId], references: [id], onDelete: Cascade)
  statusCode   ReasonStatusCode @relation(fields: [statusCodeId], references: [id])
  updatedBy    User?            @relation("BranchInventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  stockCountLines StockCountLine[]

  @@unique([branchId, serialNumberId])
  @@index([tenantId, branchId, statusCodeId])
  @@map("branch_inventories")
}

model BranchPlanogram {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  branchId      String    @map("branch_id")
  modelId       String    @map("model_id")
  maxQty        Int       @default(1) @map("max_qty")
  effectiveFrom DateTime? @map("effective_from")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([branchId, modelId])
  @@index([tenantId])
  @@map("branch_planograms")
}

model BranchMilSetting {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  branchId       String   @map("branch_id")
  modelId        String   @map("model_id")
  daysThreshold  Int      @default(30) @map("days_threshold")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([branchId, modelId])
  @@index([tenantId])
  @@map("branch_mil_settings")
}

// --- BRS planning (forecast + allocation) ---

model PlanningPeriod {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  label     String
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchTargets  BranchForecastTarget[]
  allocations    BranchAllocation[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("planning_periods")
}

model BranchForecastTarget {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  periodId       String   @map("period_id")
  branchId       String   @map("branch_id")
  revenueTarget  Decimal  @map("revenue_target") @db.Decimal(14, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period PlanningPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([periodId, branchId])
  @@index([tenantId])
  @@map("branch_forecast_targets")
}

model BranchAllocation {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  periodId      String   @map("period_id")
  branchId      String   @map("branch_id")
  modelId       String   @map("model_id")
  planogramMax  Int      @map("planogram_max")
  currentStock  Int      @map("current_stock")
  gapQty        Int      @map("gap_qty")
  computedAt    DateTime @map("computed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period PlanningPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  branch Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  model  ProductModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([periodId, branchId, modelId])
  @@index([tenantId, periodId])
  @@map("branch_allocations")
}

// --- BRS orders ---

model BranchOrder {
  id              String            @id @default(cuid())
  tenantId        String            @map("tenant_id")
  branchId        String            @map("branch_id")
  brandId         String?           @map("brand_id")
  packageTypeId   String?           @map("package_type_id")
  orderType       BranchOrderType   @map("order_type")
  status          BranchOrderStatus @default(pending_tl)
  orderNumber     String            @map("order_number")
  notes           String?
  spaRemarks      String?           @map("spa_remarks")

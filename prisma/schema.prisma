generator client {
  provider = "prisma-client"
  output   = "../src/lib/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BranchStatus {
  active
  inactive
}

enum BranchOrderStatus {
  draft
  pending_ps
  pending_tl
  pending_sp
  pending_logistics
  approved
  rejected
  cancelled
}

enum BranchOrderType {
  auto_replenish
  manual
  special
}

enum ReasonStatusCategory {
  inventory_system
  pullout_reason
  delivery_workflow
  transfer_workflow
  pullout_workflow
}

enum LookupRecordStatus {
  active
  inactive
}

enum AtrStatus {
  open
  reserve
  closed
}

enum StockCountSessionStatus {
  draft
  in_progress
  counting_complete
  variances_under_investigation
  pending_adjustment
  adjustment_requested
  closed
}

enum StockCountLineStatus {
  pending
  counted
  variance
  resolved
}

enum StockVarianceStatus {
  open
  investigating
  approved_adjustment
  rejected
  sap_handoff
  closed
}

enum SapIntegrationJobStatus {
  pending
  processing
  completed
  failed
  dead_letter
}

enum SapIntegrationJobType {
  approved_order
  pullout_itr
  sales_summary
  inventory_sync_inbound
  inventory_adjustment
  delivery_sync_inbound
}

enum ReturnRequestStatus {
  pending_cs
  pending_tl
  approved
  rejected
  completed
}

enum SkuStatus {
  active
  hold
  retired
}

/// SN movement ledger types from Excel Schema (Historical Details).
enum SerialHistoryTxnType {
  grpo
  delivery
  backload
  inv_acknowledgement
  inv_status_update
  transfer
  pullout
  sales
  reserved_sold
  return
  replacement
  pcount
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  tagline   String?
  logo      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users       User[]
  roles       Role[]
  departments Department[]
  auditLogs   AuditLog[]
  policies    Policy[]

  brands              Brand[]
  categories          Category[]
  models              ProductModel[]
  areas               Area[]
  regions             Region[]
  provinces           Province[]
  packageTypes        PackageType[]
  paymentTypes        PaymentType[]
  saleTypes           SaleType[]
  features            Feature[]
  sizes               Size[]
  actualSizes         ActualSize[]
  resolutions         Resolution[]
  dealerAreas         DealerArea[]
  branchAreas         BranchArea[]
  modeOfPayments      ModeOfPayment[]
  promoTypes          PromoType[]
  dealerTypes         DealerType[]
  customerDeliveryMethods CustomerDeliveryMethod[]
  problemDescriptions ProblemDescription[]
  documentTypes       DocumentType[]
  returnTypes         ReturnType[]
  branchStatusTypes   BranchStatusType[]
  dealers             Dealer[]
  serviceCenters      ServiceCenter[]
  priceLists          PriceList[]
  branches            Branch[]
  warehouses          Warehouse[]
  aors                Aor[]
  serialNumbers       SerialNumber[]
  branchInventories   BranchInventory[]
  branchPlanograms    BranchPlanogram[]
  branchMilSettings   BranchMilSetting[]
  branchOrders        BranchOrder[]
  branchDeliveries    BranchDelivery[]
  branchTransfers     BranchTransfer[]
  branchPullouts      BranchPullout[]
  branchSales         BranchSalesTransaction[]
  branchReturnRequests BranchReturnRequest[]
  branchBackloads     BranchBackload[]
  branchQuotas        BranchQuota[]
  salesReplacements   SalesReplacement[]
  warehouseInventories WarehouseInventory[]
  serialNumberHistories SerialNumberHistory[]
  serviceCenterInventories ServiceCenterInventory[]
  serviceCenterOrders ServiceCenterOrder[]
  serviceCenterDeliveries ServiceCenterDelivery[]
  serviceBackloads    ServiceBackload[]
  serviceCenterSales  ServiceCenterSalesTransaction[]
  serviceCenterPullouts ServiceCenterPullout[]
  reasonStatuses      ReasonStatus[]
  reasonStatusCodes   ReasonStatusCode[]
  planningPeriods     PlanningPeriod[]
  branchForecastTargets BranchForecastTarget[]
  branchAllocations   BranchAllocation[]
  stockCountSessions  StockCountSession[]
  stockVariances      StockVariance[]
  sapIntegrationJobs  SapIntegrationJob[]
  sapServiceLayerConfigs SapServiceLayerConfig[]
  announcements       Announcement[]
  competitorObservations CompetitorObservation[]

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  email         String
  name          String    @default("")
  /// App-managed hash; Better Auth credential accounts mirror this in Account.password.
  passwordHash  String    @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  departmentId  String?   @map("department_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id])
  userRoles  UserRole[]
  accounts   Account[]
  sessions   Session[]
  auditLogs  AuditLog[]
  policiesCreated Policy[]       @relation("PolicyCreatedBy")
  policyVersionsCreated PolicyVersion[] @relation("PolicyVersionCreatedBy")
  policiesReviewing Policy[]     @relation("PolicyReviewer")
  policyReviewEvents PolicyReviewEvent[]
  policyAttachmentsUploaded PolicyAttachment[] @relation("PolicyAttachmentUploadedBy")
  aors                      Aor[]
  aorsCreated               Aor[]               @relation("AorCreatedBy")
  branchOrdersCreated       BranchOrder[]       @relation("BranchOrderCreatedBy")
  branchOrdersApproved      BranchOrder[]       @relation("BranchOrderApprovedBy")
  branchInventoriesUpdated  BranchInventory[]   @relation("BranchInventoryUpdatedBy")
  branchPulloutsCreated     BranchPullout[]     @relation("BranchPulloutCreatedBy")
  branchPulloutsScheduled   BranchPullout[]     @relation("BranchPulloutScheduledBy")
  returnRequestsSubmitted   BranchReturnRequest[] @relation("ReturnRequestedBy")
  returnRequestsEvaluated   BranchReturnRequest[] @relation("ReturnEvaluatedBy")
  returnRequestsApproved    BranchReturnRequest[] @relation("ReturnApprovedBy")
  returnRequestsAccepted    BranchReturnRequest[] @relation("ReturnAcceptedBy")
  salesReplacementsTransacted SalesReplacement[] @relation("SalesReplacementTransactedBy")
  serialNumberHistoriesCreated SerialNumberHistory[] @relation("SerialNumberHistoryCreatedBy")
  stockCountSessionsCreated StockCountSession[]   @relation("StockCountSessionCreatedBy")
  stockCountLinesCounted    StockCountLine[]      @relation("StockCountLineCountedBy")
  stockVariancesInvestigated StockVariance[]      @relation("StockVarianceInvestigatedBy")
  stockVariancesAdjustmentRequested StockVariance[] @relation("StockVarianceAdjustmentRequestedBy")
  announcementsCreated      Announcement[]        @relation("AnnouncementCreatedBy")
  competitorObservationsCreated CompetitorObservation[] @relation("CompetitorObservationCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  slug        String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_roles")
}

model Department {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  name      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entityType])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

model Policy {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  title       String
  description String?
  status      String    @default("draft")
  createdById String    @map("created_by_id")
  reviewerId  String?   @map("reviewer_id")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("PolicyCreatedBy", fields: [createdById], references: [id])
  reviewer     User?               @relation("PolicyReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  versions     PolicyVersion[]
  reviewEvents PolicyReviewEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("policies")
}

model PolicyVersion {
  id          String   @id @default(cuid())
  policyId    String   @map("policy_id")
  version     Int
  content     String   @db.Text
  status      String   @default("draft")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  policy      Policy             @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation("PolicyVersionCreatedBy", fields: [createdById], references: [id])
  attachments PolicyAttachment[]

  @@unique([policyId, version])
  @@map("policy_versions")
}

model PolicyReviewEvent {
  id        String   @id @default(cuid())
  policyId  String   @map("policy_id")
  userId    String   @map("user_id")
  action    String
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([policyId, createdAt])
  @@map("policy_review_events")
}

model PolicyAttachment {
  id              String   @id @default(cuid())
  policyVersionId String   @map("policy_version_id")
  fileName        String   @map("file_name")
  storagePath     String   @map("storage_path")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  uploadedById    String   @map("uploaded_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation("PolicyAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([policyVersionId])
  @@map("policy_attachments")
}

// Better Auth adapter tables
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// --- BRS reference data ---

model Brand {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  code      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models       ProductModel[]
  branchOrders BranchOrder[]
  branchQuotas BranchQuota[]
  serviceCenterOrders ServiceCenterOrder[]
  competitorObservations CompetitorObservation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("brands")
}

model Category {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  code         String?
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models ProductModel[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("categories")
}

model ProductModel {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  brandId      String?   @map("brand_id")
  categoryId   String?   @map("category_id")
  featureId    String?   @map("feature_id")
  resolutionId String?   @map("resolution_id")
  actualSizeId String?   @map("actual_size_id")
  skuCode      String    @map("sku_code")
  name         String
  description  String?
  srp          Decimal?  @db.Decimal(12, 2)
  cbm          Decimal?  @db.Decimal(10, 4)
  status       SkuStatus @default(active)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand              Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category           Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  feature            Feature?             @relation(fields: [featureId], references: [id], onDelete: SetNull)
  resolution         Resolution?          @relation(fields: [resolutionId], references: [id], onDelete: SetNull)
  actualSize         ActualSize?          @relation(fields: [actualSizeId], references: [id], onDelete: SetNull)
  serialNumbers      SerialNumber[]
  branchPlanograms   BranchPlanogram[]
  branchMilSettings  BranchMilSetting[]
  branchOrderDetails BranchOrderDetail[]
  branchAllocations  BranchAllocation[]
  stockCountLines    StockCountLine[]
  priceLists         PriceList[]
  salesTransactionDetails BranchSalesTransactionDetail[]
  serviceCenterOrderDetails ServiceCenterOrderDetail[]
  competitorObservations CompetitorObservation[]

  @@unique([tenantId, skuCode])
  @@index([tenantId])
  @@index([brandId])
  @@map("product_models")
}

model Area {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  code         String
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches       Branch[]
  dealers        Dealer[]
  serviceCenters ServiceCenter[]
  serviceCenterLocations ServiceCenterLocation[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("areas")
}

model Region {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provinces              Province[]
  branches               Branch[]
  serviceCenterLocations ServiceCenterLocation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("regions")
}

model Province {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  regionId     String?            @map("region_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  region                 Region?                 @relation(fields: [regionId], references: [id], onDelete: SetNull)
  branches               Branch[]
  serviceCenterLocations ServiceCenterLocation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("provinces")
}

model PackageType {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchOrders BranchOrder[]
  branchSales  BranchSalesTransaction[]
  priceLists   PriceList[]
  serviceCenterOrders ServiceCenterOrder[]
  serviceCenterSales  ServiceCenterSalesTransaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("package_types")
}

model PaymentType {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchSales  BranchSalesTransaction[]
  serviceCenterSales ServiceCenterSalesTransaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("payment_types")
}

model SaleType {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchSales  BranchSalesTransaction[]
  serviceCenterSales ServiceCenterSalesTransaction[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sale_types")
}

// --- Master-data lookups ---

model Feature {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models ProductModel[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("features")
}

model Size {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actualSizes ActualSize[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("sizes")
}

model ActualSize {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  sizeId       String             @map("size_id")
  name         String
  class        String?
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  size   Size           @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  models ProductModel[]

  @@unique([tenantId, sizeId, name])
  @@index([tenantId])
  @@map("actual_sizes")
}

model Resolution {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models ProductModel[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("resolutions")
}

model DealerArea {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dealers                Dealer[]
  serviceCenters         ServiceCenter[]
  serviceCenterLocations ServiceCenterLocation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("dealer_areas")
}

model BranchArea {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches               Branch[]
  serviceCenterLocations ServiceCenterLocation[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branch_areas")
}

model ModeOfPayment {
  id           String             @id @default(cuid())
  tenantId     String             @map("tenant_id")
  name         String
  recordStatus LookupRecordStatus @default(active) @map("record_status")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")


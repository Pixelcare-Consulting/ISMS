  status                  StockVarianceStatus @default(open)
  description             String?
  investigatedById        String?             @map("investigated_by_id")
  investigatedAt          DateTime?           @map("investigated_at")
  investigationNotes      String?             @map("investigation_notes")
  adjustmentRequestedAt   DateTime?           @map("adjustment_requested_at")
  adjustmentRequestedById String?             @map("adjustment_requested_by_id")
  sapDocRef               String?             @map("sap_doc_ref")
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session                 StockCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  line                    StockCountLine?   @relation(fields: [lineId], references: [id], onDelete: SetNull)
  investigatedBy          User?             @relation("StockVarianceInvestigatedBy", fields: [investigatedById], references: [id], onDelete: SetNull)
  adjustmentRequestedBy   User?             @relation("StockVarianceAdjustmentRequestedBy", fields: [adjustmentRequestedById], references: [id], onDelete: SetNull)

  @@index([tenantId, sessionId, status])
  @@map("stock_variances")
}


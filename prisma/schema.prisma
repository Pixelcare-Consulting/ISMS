  pulloutNo               String    @map("pullout_no")
  statusCodeId            String?   @map("status_code_id")
  reasonStatusId          String?   @map("reason_status_id")
  reasonStatusCodeId      String?   @map("reason_status_code_id")
  waybillNo               String?   @map("waybill_no")
  scheduledAt             DateTime? @map("scheduled_at")
  notes                   String?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  tenant                Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceCenter         ServiceCenter                    @relation(fields: [serviceCenterId], references: [id], onDelete: Cascade)
  serviceCenterLocation ServiceCenterLocation?           @relation(fields: [serviceCenterLocationId], references: [id], onDelete: SetNull)
  statusCode            ReasonStatusCode?                @relation("ScPulloutWorkflowStatus", fields: [statusCodeId], references: [id], onDelete: SetNull)

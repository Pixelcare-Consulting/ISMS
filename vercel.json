{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "develop": true
    }
  },
  "ignoreCommand": "if [ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"develop\" ]; then exit 0; fi; exit 1",
  "crons": [
    {
      "path": "/api/cron/sap-sync",
      "schedule": "*/5 * * * *"
    }
  ]
}
